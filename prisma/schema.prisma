generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SystemRole {
  USER
  SYSTEM_ADMIN
}

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  password             String?   // Optional for OAuth users
  name                 String?
  createdAt            DateTime  @default(now())

  // Admin & Billing
  role                 SystemRole @default(USER)
  isBlocked            Boolean   @default(false)
  subscriptionPlan     String    @default("FREE")
  subscriptionExpires  DateTime?

  // Email verification
  emailVerified        Boolean   @default(false)
  emailVerifyToken     String?   @unique
  emailVerifyExpires   DateTime?

  // Password Reset
  resetPasswordToken   String?   @unique
  resetPasswordExpires DateTime?

  // OAuth (infrastructure ready, disabled in UI)
  googleId             String?   @unique
  githubId             String?   @unique
  provider             String    @default("local") // "local" | "google" | "github"

  // Brute force protection
  loginAttempts        Int       @default(0)
  lockUntil            DateTime?

  // Two-factor authentication (TOTP)
  twoFactorEnabled       Boolean   @default(false)
  twoFactorSecret        String?   // confirmed secret, only set once 2FA is enabled
  twoFactorSecretPending String?   // secret generated during setup, awaiting confirmation
  twoFactorRecoveryCodes String?   // JSON array of bcrypt-hashed one-time recovery codes

  workspaces           Workspace[]
  workspaceMembers     WorkspaceMember[]
  apiKeys              ApiKey[]
}

model Workspace {
  id               String             @id @default(uuid())
  name             String
  userId           String
  user             User               @relation(fields: [userId], references: [id])
  monitors         Monitor[]
  monitorGroups    MonitorGroup[]
  statusPages      PublicStatusPage[]
  createdAt        DateTime           @default(now())
  smtpHost         String?
  smtpPort         Int?
  smtpUser         String?
  smtpPass         String?
  smtpFrom         String?
  telegramBotToken String?
  logRetentionDays Int                @default(90)
  members          WorkspaceMember[]
  apiKeys          ApiKey[]
}

model MonitorGroup {
  id          String    @id @default(uuid())
  name        String
  color       String    @default("#f97316")
  order       Int       @default(0)
  collapsed   Boolean   @default(false)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  monitors    Monitor[]
  createdAt   DateTime  @default(now())

  // --- Faz 3.5: lokasyon (composite) alarmi ---
  // Grubu bir "lokasyon" gibi ele alir: uyelerin bir kismi down ise degraded,
  // tamami down ise down kabul edilir ve bu iki durum AYRI kanallara bildirilir.
  // Karar mantigi lib/composite.ts icinde, saf ve test edilmis haldedir.
  compositeEnabled     Boolean @default(false)
  compositeStatus      String  @default("up") // up | degraded | down (son bilinen bilesik durum)
  degradedThreshold    Int     @default(1)    // kac uye down olunca degraded sayilir
  suppressMemberAlerts Boolean @default(false) // uye monitorler ayrica bildirim atmasin

  // Bildirim kanallari JSON string olarak tutulur: {alertEmail, slackWebhook,
  // telegramChatId, discordWebhook, teamsWebhook, zoomWebhook, genericWebhook}.
  // Monitor'deki gibi duz kolonlara acilsalardi ayni yedi alan iki severity icin
  // tekrarlanip on dorde cikacakti; bu alanlar hicbir sorguda filtrelenmedigi
  // icin JSON tasima maliyeti yok. Sema dogrulamasi lib/validation.ts'te.
  degradedChannels     String?
  downChannels         String?
}

model Monitor {
  id            String    @id @default(uuid())
  name          String
  monitorType   String    @default("HTTP") // HTTP, TCP, HEARTBEAT
  url           String?   // Optional for TCP, optional for Heartbeat
  port          Int?      // For TCP monitors
  expectedKeyword String? // For HTTP assertion
  customHeaders String?   // For HTTP API checks (JSON string)
  heartbeatGrace Int      @default(5) // Grace period in minutes for HEARTBEAT
  method        String    @default("GET")
  interval      Int       @default(60)
  status        String    @default("up") // "up", "paused", "maintenance"
  currentStatus String    @default("up") // "up", "down", "degraded", "maintenance"
  lastChecked   DateTime?
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  groupId       String?
  group         MonitorGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  pingLogs      PingLog[]
  maintenanceWindows MaintenanceWindow[]
  statusPages   PublicStatusPage[] // Implicit Many-to-Many
  createdAt     DateTime  @default(now())
  alertThreshold        Int     @default(2)
  alertEmail            String?
  slackWebhook          String?
  telegramChatId        String?
  zoomWebhook           String?
  discordWebhook        String?
  teamsWebhook          String?
  genericWebhook        String?
  responseTimeThreshold Int?
  consecutiveFailures   Int     @default(0)
  incidentActive        Boolean @default(false)
  notifyOnDegraded      Boolean @default(false)

  // SSL / TLS Certificate Tracking
  sslCheckEnabled Boolean   @default(true)
  sslExpiry       DateTime?
  sslIssuer       String?
  sslSubject      String?
  sslDaysLeft     Int?
  sslValid        Boolean?
  sslLastChecked  DateTime?

  // DNS Tracking
  dnsResolutionTime Int?
  dnsResolvedIp     String?
  dnsLastChanged    DateTime?
}

model PingLog {
  id           String   @id @default(uuid())
  monitorId    String
  monitor      Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  timestamp    DateTime @default(now())
  status       Int      // 1 = up, 0 = down, 2 = degraded
  responseTime Int
  statusCode   Int
  errorMessage String?
}

model MaintenanceWindow {
  id          String   @id @default(uuid())
  monitorId   String
  monitor     Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  startTime   DateTime
  endTime     DateTime
  timezone    String   @default("UTC")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model PublicStatusPage {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  slug        String    @unique
  title       String    @default("System Status")
  description String?
  themeColor  String    @default("#f97316") // Orange-500 default
  logoUrl     String?
  monitors    Monitor[] // Implicit Many-to-Many
  createdAt   DateTime  @default(now())
}

// Programmatic access tokens (Faz 1.5). The raw key is shown to the user only
// once, at creation time — only its SHA-256 hash is ever persisted.
model ApiKey {
  id          String    @id @default(uuid())
  name        String
  keyHash     String    @unique
  preview     String    // e.g. "umk_ab12…cd34", shown in the UI so users can tell keys apart
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
}

// Persistent audit trail (Faz 1.3). Intentionally NOT linked via Prisma
// relations/foreign keys to User/Workspace: an audit record must survive the
// deletion of the account or workspace it describes, so userId/workspaceId
// here are plain (unenforced) references rather than @relation fields.
model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  workspaceId String?
  action      String   // e.g. "auth.login", "monitor.delete", "admin.user.block"
  targetType  String?  // e.g. "Monitor", "User", "Workspace"
  targetId    String?
  ip          String?
  metadata    String?  // JSON-encoded extra context
  createdAt   DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model WorkspaceMember {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String
  role        String    @default("ADMIN") // OWNER or ADMIN
  createdAt   DateTime  @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}
